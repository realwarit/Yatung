# คัดลอกเป็น .env แล้วกรอกค่าจริง (ห้าม commit .env)

# ---------- Database ----------
DB_ROOT_PASSWORD=change-me-root
DB_NAME=yatung
DB_USER=yatung
DB_PASSWORD=change-me

# ---------- Auth ----------
# สร้างด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---------- Node-RED editor ----------
NODE_RED_CREDENTIAL_SECRET=change-me-too
NODE_RED_ADMIN_USER=admin
# bcrypt hash ของรหัสผ่าน editor: docker compose run --rm nodered npx node-red admin hash-pw
# ค่าด้านล่างคือรหัส "demo1234" — เปลี่ยนก่อนเปิด tunnel
# ต้องครอบด้วย single quote เพื่อไม่ให้ Compose ตีความ $ เป็นตัวแปร
NODE_RED_ADMIN_HASH='$2a$10$JlkiZMzaRrvZFFKXT3ZhT.B4k9YWBUEIdj8L5xje3rXu2Ir6jVZzC'

# ---------- AI (Gemini multimodal: อ่านรูป + ตีความในครั้งเดียว ใช้ key เดียว) ----------
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# รุ่นสำรอง: สลับไปทันที 1 ครั้งเมื่อรุ่นหลักตอบ 429/503 หรือ timeout (ต้องเป็นคนละรุ่นกับ LLM_MODEL)
LLM_MODEL_FALLBACK=gemini-3.1-flash-lite
# ไม่ใช้ gemini-3.8-flash: ไม่รับ thinkingLevel minimal และโควตาฟรีน้อย (5 ครั้ง/นาที, 20 ครั้ง/วัน)
# true = ข้าม Gemini ตอบผลตัวอย่าง (prompts/mock-response.json) หลังรอ 2 วินาที — ใช้ตอน dev / เน็ตล่ม / โควตาหมด
AI_MOCK=false

# ---------- LINE Messaging API ----------
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ---------- Web Push (สร้างด้วย: npx web-push generate-vapid-keys) ----------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------- Public URL (จาก tunnel) ----------
PUBLIC_BASE_URL=https://yatung.example.com
CF_TUNNEL_TOKEN=

# ---------- Dev/test scripts ----------
DEMO_PASSWORD=

# คัดลอกเป็น .env แล้วกรอกค่าจริง (ห้าม commit .env)

# ---------- Database ----------
DB_ROOT_PASSWORD=change-me-root
DB_NAME=yatung
DB_USER=yatung
DB_PASSWORD=change-me

# ---------- Auth ----------
# สร้างด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---------- Node-RED editor ----------
NODE_RED_CREDENTIAL_SECRET=change-me-too
NODE_RED_ADMIN_USER=admin
# bcrypt hash ของรหัสผ่าน editor: docker compose run --rm nodered npx node-red admin hash-pw
# ค่าด้านล่างคือรหัส "demo1234" — เปลี่ยนก่อนเปิด tunnel
# ต้องครอบด้วย single quote เพื่อไม่ให้ Compose ตีความ $ เป็นตัวแปร
NODE_RED_ADMIN_HASH='$2a$10$JlkiZMzaRrvZFFKXT3ZhT.B4k9YWBUEIdj8L5xje3rXu2Ir6jVZzC'

# ---------- AI (Gemini multimodal: อ่านรูป + ตีความในครั้งเดียว ใช้ key เดียว) ----------
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# รุ่นสำรอง: สลับไปทันที 1 ครั้งเมื่อรุ่นหลักตอบ 429/503 หรือ timeout (ต้องเป็นคนละรุ่นกับ LLM_MODEL)
LLM_MODEL_FALLBACK=gemini-3.1-flash-lite
# ไม่ใช้ gemini-3.8-flash: ไม่รับ thinkingLevel minimal และโควตาฟรีน้อย (5 ครั้ง/นาที, 20 ครั้ง/วัน)
# true = ข้าม Gemini ตอบผลตัวอย่าง (prompts/mock-response.json) หลังรอ 2 วินาที — ใช้ตอน dev / เน็ตล่ม / โควตาหมด
AI_MOCK=false

# ---------- Public URL (จาก tunnel ngrok) ----------
# !! ลำดับสำคัญ: Compose แทนค่า ${...} จากตัวแปรที่ "ประกาศไว้ก่อนหน้า" เท่านั้น — ถ้า PUBLIC_BASE_URL อยู่เหนือ NGROK_DOMAIN จะได้ "https://" เปล่าๆ
# !! กฎของไฟล์นี้: ตัวแปรที่ถูกอ้างถึง (NGROK_DOMAIN) ต้องอยู่ก่อนตัวที่อ้างถึง (PUBLIC_BASE_URL, LINE_MASCOT_URL) เสมอ
# tunnel = ngrok (docker compose --profile tunnel up -d) : สมัครฟรีแล้วจองโดเมนคงที่ที่ dashboard.ngrok.com
NGROK_AUTHTOKEN=
NGROK_DOMAIN=your-name.ngrok-free.dev
PUBLIC_BASE_URL=https://${NGROK_DOMAIN}

# ---------- LINE Messaging API ----------
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# Basic ID ของ Official Account (ขึ้นต้นด้วย @) — ใช้สร้างลิงก์ "เปิด LINE แล้วส่งรหัส"
LINE_OA_BASIC_ID=@your-oa-id
# ปกติไม่ต้องแก้ (เปลี่ยนเฉพาะตอนทดสอบกับ LINE ปลอม scripts/fake-line.js)
LINE_API_BASE=https://api.line.me
# เพดานข้อความ push ต่อเดือน (แพ็กเกจฟรีของ LINE = 200) ; ใช้ค่าที่น้อยกว่าระหว่างค่านี้กับโควตาจริงจาก LINE
LINE_PUSH_MONTHLY_CAP=200
# โควตาที่กันไว้ให้ข้อความแจ้งญาติ — ข้อความเตือนปกติหยุดส่งเมื่อใช้ไปถึง (เพดาน - ค่านี้)
LINE_PUSH_RESERVE=30
# URL รูปน้องยาตรง (PNG, https) ในข้อความ Flex — ว่าง = ${PUBLIC_BASE_URL}/line/mascot.png (ต้องอยู่หลัง PUBLIC_BASE_URL ตามกฎด้านบน)
# ถ้ารูปไม่ขึ้นเพราะหน้าเตือนของ ngrok ฟรี ให้ย้ายรูปไปโฮสต์ที่อื่นแล้วใส่ URL ตรงนี้
LINE_MASCOT_URL=
# true = เปิดปุ่ม "ทดลองส่งเตือนตอนนี้" และ POST /api/demo/remind-now (ปิดไว้ตอนใช้งานจริง)
DEMO_MODE=false

# ---------- Web Push (สร้างด้วย: npx web-push generate-vapid-keys) ----------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------- Dev/test scripts ----------
DEMO_PASSWORD=
